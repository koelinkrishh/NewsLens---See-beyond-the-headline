FROM python:3.13-slim

WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements-api.txt .

# Install dependencies (forcing CPU-only packages for PyTorch to block NVIDIA CUDA downloads)
RUN pip install --no-cache-dir -r requirements-api.txt --extra-index-url https://download.pytorch.org/whl/cpu

# Download SpaCy model en_core_web_sm
RUN python -m spacy download en_core_web_sm

# Download NLTK resources
RUN python -m nltk.downloader punkt punkt_tab stopwords

# Copy only the runtime source files needed for the API
COPY app/ ./app
COPY src/ ./src

# Expose port
EXPOSE 8099

# Run the API
CMD ["uvicorn", "app.api_lc:app", "--host", "0.0.0.0", "--port", "8099"]
